# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.
# compose.yaml과 Spring Boot(application.properties의 spring.config.import)가 같은 파일을 읽는다.
# 3306을 이미 쓰고 있으면 13306 등으로 바꾼다(앱도 같은 값을 읽는다).
DB_PORT=3306
DB_NAME=feedablackhole
DB_USERNAME=blackhole
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# JWT 서명 키: 32자 이상의 무작위 문자열. 예) python -c "import secrets;print(secrets.token_urlsafe(48))"
# 실제 값은 .env에만 두고 커밋하지 않는다. 키가 바뀌면 발급된 액세스 토큰이 모두 무효가 된다.
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
