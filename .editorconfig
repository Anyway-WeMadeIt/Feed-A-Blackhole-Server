root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# IntelliJ IDEA Java formatter options; other editors may ignore ij_* keys.
# Naming checks require IDE inspections or a separate linter.
[*.java]
indent_size = 4
ij_continuation_indent_size = 8
ij_java_align_multiline_parameters = false
ij_java_align_multiline_parameters_in_calls = false

# Opening braces stay on the declaration/control-statement line.
ij_java_class_brace_style = end_of_line
ij_java_method_brace_style = end_of_line
ij_java_block_brace_style = end_of_line
ij_java_lambda_brace_style = end_of_line
ij_java_else_on_new_line = false
ij_java_catch_on_new_line = false
ij_java_finally_on_new_line = false
ij_java_while_on_new_line = false

# Reformat Code adds braces even to single-statement control bodies.
ij_java_if_brace_force = always
ij_java_for_brace_force = always
ij_java_while_brace_force = always
ij_java_do_while_brace_force = always
ij_java_keep_control_statement_in_one_line = false
ij_java_keep_simple_blocks_in_one_line = false
ij_java_keep_simple_methods_in_one_line = false
ij_java_keep_simple_classes_in_one_line = false

# Prefer explicit imports; remove the IDE's default wildcard packages.
# The high thresholds discourage wildcard conversion, not lint violations.
ij_java_use_single_class_imports = true
ij_java_class_count_to_use_import_on_demand = 9999
ij_java_names_count_to_use_import_on_demand = 9999
ij_java_packages_to_use_import_on_demand = unset

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
